# Gemini — embeddings, extraction, agent, text-to-speech
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qdrant Cloud — vector index
# Free cluster: https://cloud.qdrant.io   (the REST port :6333 is required)
QDRANT_URL=https://xxxxxxxx.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Supabase — Postgres, auth, and audio storage
# Project Settings -> API   https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
